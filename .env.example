# Compose only. For native Python use backend/.env.example instead.
# Empty key = read-only API. Generate a private key locally; never commit .env.
WRITE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CELERY_QUEUE=main-queue
MONITOR_INTERVAL_SECONDS=3600
BROWSER_FALLBACK=false
ENVIRONMENT=development
DEMO_MODE=false
VITE_API_BASE_URL=http://localhost:8000/api/v1
# PostgreSQL overlay only; replace locally with a URL-safe random password.
# POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
